<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Nền vàng amber đậm: vàng giàu, không tối, đủ contrast cho white text -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#9B5200"
                android:centerColor="#D4860B"
                android:endColor="#B36B00"
                android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Gold highlight sáng từ trên: luxury lighting effect -->
    <item android:bottom="75dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#55FFD054"
                android:endColor="#00FFD054"
                android:type="linear" />
            <corners android:topLeftRadius="24dp" android:topRightRadius="24dp" />
        </shape>
    </item>
    <!-- Vệt shimmer trung tâm: tăng độ sáng chiều ngang -->
    <item android:top="30dp" android:bottom="30dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#00FFE880"
                android:centerColor="#20FFE880"
                android:endColor="#00FFE880"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
