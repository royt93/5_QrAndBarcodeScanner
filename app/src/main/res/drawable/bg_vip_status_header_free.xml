<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Nền cream-vàng nhạt pastel: nhẹ nhàng, ấm áp -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#EDD9A3"
                android:centerColor="#F5E8C0"
                android:endColor="#E8D090"
                android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Highlight kem sáng từ trên -->
    <item android:bottom="60dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#40FFFFF0"
                android:endColor="#00FFFFF0"
                android:type="linear" />
            <corners android:topLeftRadius="24dp" android:topRightRadius="24dp" />
        </shape>
    </item>
</layer-list>
