<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="?android:attr/windowBackground">

    <!-- Action Bar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="Back"
        app:title=""
        android:elevation="4dp" />

    <!-- Scrollable main content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="24dp"
            android:paddingTop="48dp"
            android:paddingBottom="32dp">

            <!-- Success icon animated -->
            <ImageView
                android:id="@+id/imageViewSuccess"
                android:layout_width="88dp"
                android:layout_height="88dp"
                app:srcCompat="@drawable/ic_confirm_enabled"
                app:tint="@color/green"
                android:layout_marginBottom="20dp" />

            <!-- Animated content group -->
            <LinearLayout
                android:id="@+id/layoutContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/activity_batch_export_success_title"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/default_text_color"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/textViewDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:textColor="@color/secondary_text_color"
                    android:layout_marginBottom="24dp" />

                <!-- File info card with prominent "Open File" button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_dialog_glass"
                    android:padding="16dp"
                    android:layout_marginBottom="32dp">

                    <!-- Path row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            app:srcCompat="@drawable/ic_download"
                            app:tint="@color/blue"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:id="@+id/textViewPath"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="13sp"
                            android:textColor="@color/secondary_text_color" />
                    </LinearLayout>

                    <!-- Open File: full-width prominent button -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/buttonOpenFile"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="@string/activity_batch_export_button_open_file"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:background="@drawable/bg_gradient_button" />

                </LinearLayout>

                <!-- Continue Scanning -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/buttonContinueScanning"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/activity_batch_export_button_continue"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_gradient_button"
                    android:layout_marginBottom="12dp" />

                <!-- View History (ghost style) -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/buttonBackHome"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/activity_batch_export_button_history"
                    android:textColor="@color/blue"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_premium_button_secondary" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
