<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="?android:attr/windowBackground">

    <!-- Action Bar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="Back"
        app:title=""
        android:elevation="4dp" />

    <!-- Scrollable main content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="24dp"
            android:paddingTop="48dp"
            android:paddingBottom="32dp">

            <!-- Success icon with animation target -->
            <ImageView
                android:id="@+id/imageViewSuccess"
                android:layout_width="100dp"
                android:layout_height="100dp"
                app:srcCompat="@drawable/ic_confirm_enabled"
                app:tint="@color/green"
                android:layout_marginBottom="24dp" />

            <!-- Animated content -->
            <LinearLayout
                android:id="@+id/layoutContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Export Successful!"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/default_text_color"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/textViewDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:textColor="@color/secondary_text_color"
                    android:layout_marginBottom="8dp" />

                <!-- File info card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_dialog_glass"
                    android:padding="16dp"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="40dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        app:srcCompat="@drawable/ic_download"
                        app:tint="@color/blue"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:id="@+id/textViewPath"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="13sp"
                        android:textColor="@color/secondary_text_color" />
                </LinearLayout>

                <!-- Primary button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/buttonContinueScanning"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Continue Scanning"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_premium_button"
                    android:layout_marginBottom="16dp" />

                <!-- Ghost button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/buttonBackHome"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="View History"
                    android:textColor="@color/blue"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_premium_button_secondary" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
