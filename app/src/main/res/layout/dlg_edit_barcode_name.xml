<?xml version="1.0" encoding="utf-8"?>
<!--
    M3 TextInputLayout (OutlinedBox) inside the Edit Barcode Name dialog.
    The TextInputEditText keeps the same ID (editTextBarcodeName) so the
    DialogFragmentEditBarcodeName.kt code requires zero changes.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/Theme.MaterialComponents.DayNight"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:hint="@string/dialog_edit_barcode_name_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextBarcodeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/edit_text_text_color"
            android:textSize="16sp" />

    </com.google.android.material.textfield.TextInputLayout>

</FrameLayout>
