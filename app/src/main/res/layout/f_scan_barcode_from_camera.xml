<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Camera fills ENTIRE screen (behind all overlays) -->
    <com.budiyev.android.codescanner.CodeScannerView
        android:id="@+id/scannerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:autoFocusButtonVisible="false"
        app:flashButtonVisible="false"
        app:frameAspectRatioHeight="1"
        app:frameAspectRatioWidth="1"
        app:frameColor="@color/white"
        app:frameSize="0.6"
        app:frameThickness="2.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:maskColor="@color/black_transparent3" />

    <!-- TOP CONTROLS: Flash | Batch Scan | Scan Image
         Equal weight in ONE horizontal LinearLayout → pixel-perfect alignment -->
    <LinearLayout
        android:id="@+id/layoutTopControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/layoutFlashContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="?selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imageViewFlash"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:srcCompat="@drawable/ic_flash" />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/textViewFlash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/fragment_scan_barcode_from_camera_flash"
                android:textColor="@color/white"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutBatchScanContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="?selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imageViewBatchScan"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:srcCompat="@drawable/ic_scan_white" />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/textViewBatchScan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/mode_batch_scan"
                android:textColor="@color/white"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutScanFromFileContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="?selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imageViewScanFromFile"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:srcCompat="@drawable/ic_image_white" />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/textViewScanFromFile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/fragment_scan_barcode_from_camera_scan_from_file"
                android:textColor="@color/white"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- BATCH LIST PANEL: anchored BELOW top controls, ABOVE QR scan frame center -->
    <!-- QR frame is centered in the full screen → panel at top never overlaps it -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutBatchListPanel"
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        android:background="@drawable/bg_dialog_glass"
        android:elevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/layoutTopControls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewBatch"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:padding="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/buttonExportCsv" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonExportCsv"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:text="@string/action_export_csv"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_premium_button"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ZOOM CONTROLS at bottom -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/buttonDecreaseZoom"
        android:layout_width="@dimen/button_zoom_size"
        android:layout_height="@dimen/button_zoom_size"
        android:layout_marginStart="@dimen/margin"
        android:layout_marginBottom="@dimen/margin_large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/ic_minus" />

    <androidx.appcompat.widget.AppCompatSeekBar
        android:id="@+id/seekBarZoom"
        android:layout_width="0dp"
        android:layout_height="@dimen/zoom_seek_bar_height"
        android:layout_marginHorizontal="@dimen/margin_small"
        android:theme="@style/SeekBarTheme"
        app:layout_constraintBottom_toBottomOf="@id/buttonDecreaseZoom"
        app:layout_constraintEnd_toStartOf="@id/buttonIncreaseZoom"
        app:layout_constraintStart_toEndOf="@id/buttonDecreaseZoom"
        app:layout_constraintTop_toTopOf="@id/buttonDecreaseZoom" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/buttonIncreaseZoom"
        android:layout_width="@dimen/button_zoom_size"
        android:layout_height="@dimen/button_zoom_size"
        android:layout_marginEnd="@dimen/margin"
        app:layout_constraintBottom_toBottomOf="@id/buttonDecreaseZoom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/buttonDecreaseZoom"
        app:srcCompat="@drawable/ic_plus" />

</androidx.constraintlayout.widget.ConstraintLayout>
