<?xml version="1.0" encoding="utf-8"?>
<!-- UI mirror của SDK reference demo (app/src/main/res/layout/f_vip_management.xml trong
     royt93/AdmobApplovinWrapper) — giữ nguyên palette/structure gốc để nhất quán với thiết kế
     SDK author đã build+test sẵn (xem androidTest ActVipManagementInstrumentedTest/AnimationTest). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutVipRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9EE"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFF0CC"
            app:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="#FFF0CC"
                app:title="@string/vip_toolbar_title"
                app:titleTextColor="#7A4500"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:navigationIconTint="#7A4500"
                app:titleCentered="true" />
        </com.google.android.material.appbar.AppBarLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:background="#FFF9EE">

            <LinearLayout
                android:id="@+id/contentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:padding="20dp">

                <!-- 1: Status header / Hero card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardStatusHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="8dp"
                    app:strokeColor="#D4AF37"
                    app:strokeWidth="0dp"
                    app:cardPreventCornerOverlap="false"
                    app:cardUseCompatPadding="false"
                    app:contentPadding="0dp">

                    <FrameLayout
                        android:id="@+id/layoutStatusHeaderBackground"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_vip_status_header_free"
                        android:clipChildren="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="24dp">

                            <!-- 2: Crown + glow halo -->
                            <FrameLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="14dp">

                                <ImageView
                                    android:id="@+id/imgCrownGlow"
                                    android:layout_width="108dp"
                                    android:layout_height="108dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/bg_crown_glow"
                                    android:visibility="gone" />

                                <ImageView
                                    android:id="@+id/imgCrown"
                                    android:layout_width="84dp"
                                    android:layout_height="84dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@string/vip_active"
                                    android:src="@drawable/ic_workspace_premium" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/tvStatusEyebrow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="2dp"
                                android:alpha="0.9"
                                android:letterSpacing="0.18"
                                android:text="@string/vip_eyebrow"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:shadowColor="#CC000000"
                                android:shadowDx="0"
                                android:shadowDy="2"
                                android:shadowRadius="6" />

                            <TextView
                                android:id="@+id/tvStatusTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/vip_free_user"
                                android:textColor="#FFFFFF"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                android:shadowColor="#CC000000"
                                android:shadowDx="0"
                                android:shadowDy="3"
                                android:shadowRadius="8" />

                            <TextView
                                android:id="@+id/tvStatusSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="#FFE8A0"
                                android:textSize="14sp"
                                android:visibility="gone"
                                android:shadowColor="#99000000"
                                android:shadowDx="0"
                                android:shadowDy="1"
                                android:shadowRadius="4"
                                tools:text="Expires: 12/06/2026"
                                tools:visibility="visible" />

                            <!-- 4: Progress bar (elapsed) -->
                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/progressVip"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:layout_marginBottom="4dp"
                                android:visibility="gone"
                                app:indicatorColor="#FFFFFF"
                                app:trackColor="#40FFFFFF"
                                app:trackCornerRadius="4dp"
                                app:trackThickness="8dp"
                                tools:progress="40"
                                tools:visibility="visible" />

                            <!-- 5: Countdown text -->
                            <TextView
                                android:id="@+id/tvCountdown"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:fontFamily="monospace"
                                android:letterSpacing="0.04"
                                android:textColor="#FFE87A"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                android:shadowColor="#AA000000"
                                android:shadowDx="0"
                                android:shadowDy="2"
                                android:shadowRadius="6"
                                tools:text="29d 23h 59m 50s"
                                tools:visibility="visible" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvVipBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="14dp"
                            android:layout_marginEnd="14dp"
                            android:background="@drawable/bg_vip_badge"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:text="✦ VIP"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.12"
                            android:shadowColor="#80000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="3"
                            android:visibility="gone" />

                        <!-- 3: shimmer (crown shimmer bằng canvas thay vì rotation animator) -->
                        <com.mckimquyen.barcodescanner.feature.vip.GoldShimmerView
                            android:id="@+id/viewShimmer"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="invisible" />

                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 12: Active VIP card (single-entry) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVipDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:visibility="gone"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:strokeColor="#E0C060"
                    app:strokeWidth="1dp"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvActiveVipLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="🎁 New install gift"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#9B5200" />

                        <TextView
                            android:id="@+id/tvActivatedAt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textSize="14sp"
                            android:textColor="#6B4A1A"
                            tools:text="Activated: 06/06/2026 10:00" />

                        <TextView
                            android:id="@+id/tvExpiresAt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textSize="14sp"
                            android:textColor="#6B4A1A"
                            tools:text="Expires: 07/06/2026 10:00" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRevokeVip"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="8dp"
                            android:text="@string/vip_revoke_all_button"
                            android:textColor="?attr/colorError" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 6: EditText nhập token VIP -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardActivation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:strokeColor="#E0C060"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="🔑 Nhập mã kích hoạt VIP"
                            android:textColor="#9B5200"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilVipKey"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/vip_redeem_label"
                            app:endIconMode="clear_text"
                            app:helperText="@string/vip_redeem_helper"
                            app:helperTextEnabled="true"
                            app:startIconDrawable="@drawable/ic_confirmation_number">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etVipKey"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textVisiblePassword"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnActivate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/vip_redeem_button"
                            app:cornerRadius="12dp"
                            app:backgroundTint="#CC6600"
                            android:textColor="#FFFFFF" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 7: Watch ad -> 3 days VIP -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWatchAd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:padding="16dp"
                    android:text="@string/vip_watch_ad_3d"
                    android:textColor="#3D2000"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_play_circle"
                    app:iconTint="#3D2000"
                    app:backgroundTint="#F5A500" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/vip_premium_packages"
                    android:textColor="#8B6914"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- 8: Buy 30-day -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBuy30d"
                    style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:enabled="false"
                    android:text="@string/vip_buy_30d_locked"
                    android:textColor="#9B6200"
                    app:strokeColor="#E0C060"
                    app:icon="@drawable/ic_card_giftcard"
                    app:iconTint="#9B6200" />

                <!-- 9: Buy 90-day -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBuy90d"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:enabled="false"
                    android:text="@string/vip_buy_90d_locked"
                    android:textColor="#9B6200"
                    app:strokeColor="#E0C060" />

                <!-- 10: Buy 1-year -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBuy1y"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:enabled="false"
                    android:text="@string/vip_buy_1y_locked"
                    android:textColor="#9B6200"
                    app:strokeColor="#E0C060" />

                <!-- 11: Buy Lifetime -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBuyLifetime"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:enabled="false"
                    android:text="@string/vip_buy_lifetime_locked"
                    android:textColor="#9B6200"
                    app:strokeColor="#E0C060" />

                <!-- 13: Restore Purchase -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRestore"
                    style="@style/Widget.Material3.Button.TextButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:enabled="false"
                    android:text="@string/vip_restore_locked"
                    android:textColor="#9B6200"
                    app:icon="@drawable/ic_restore"
                    app:iconTint="#9B6200" />

                <TextView
                    android:id="@+id/tvPrivacyPolicy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="16dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:text="@string/policy"
                    android:textColor="#B8860B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- 5: Confetti khi activate thành công -->
    <nl.dionsegijn.konfetti.xml.KonfettiView
        android:id="@+id/viewKonfetti"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
