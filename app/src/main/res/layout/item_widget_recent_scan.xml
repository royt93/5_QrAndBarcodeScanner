<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/llRoot" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#22FFFFFF" android:padding="8dp">

    <ImageView android:id="@+id/ivIcon" android:layout_width="36dp" android:layout_height="36dp" android:layout_alignParentStart="true" android:layout_centerVertical="true" android:layout_marginEnd="8dp" android:background="@drawable/shape_background_circle" android:padding="6dp" android:tint="@android:color/white" />

    <TextView android:id="@+id/tvDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/ivIcon" android:layout_alignParentTop="true" android:textColor="@color/widget_text_secondary" android:textSize="10sp" />

    <TextView android:id="@+id/tvText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_toEndOf="@id/ivIcon" android:layout_below="@id/tvDate" android:textColor="@color/widget_text" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />

    <TextView android:id="@+id/tvFormat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/ivIcon" android:layout_below="@id/tvText" android:textColor="@color/widget_text_tertiary" android:textSize="10sp" />

</RelativeLayout>
