<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="SplashTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">@drawable/startup</item>
    </style>

    <style name="BaseAppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryDark">@color/color_primary_dark</item>
        <item name="colorAccent">@color/color_accent</item>
        <item name="android:colorBackground">@color/color_background</item>
        <item name="android:textColor">@color/default_text_color</item>
        <item name="android:textColorSecondary">@color/text_color_secondary</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/navigation_bar_color</item>
        <item name="android:actionOverflowButtonStyle">@style/ToolbarMenuButtonStyle</item>
        <item name="alertDialogTheme">@style/AppAlertDialogTheme</item>
        <item name="colorSurface">@color/dialog_background_color</item>
        <item name="colorOnSurface">@color/default_text_color</item>
    </style>

    <style name="AppTheme" parent="BaseAppTheme" />

    <!-- App theme chính là Theme.AppCompat (không phải Theme.Material3) — MaterialCardView/
         Widget.Material3.Button.* (dùng trong a_vip_management.xml, mirror UI từ SDK reference demo
         app/src/main/java/com/roy/admobwrapper/vip/) enforce cứng phải chạy trên MaterialComponents
         theme trở lên (ThemeEnforcement.checkMaterialTheme), throw IllegalArgumentException nếu
         không — và cần Material3 cụ thể (không chỉ MaterialComponents) để colorSurfaceContainerLow/
         colorOnSurfaceVariant (dùng ở v_progress_dialog.xml) resolve được. Theme riêng cho
         ActVipManagement (android:theme trong Manifest) — không đổi theme toàn app để tránh ảnh
         hưởng các màn hình khác. -->
    <style name="VipTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryDark">@color/color_primary_dark</item>
        <item name="colorAccent">@color/color_accent</item>
        <item name="android:colorBackground">@color/color_background</item>
        <item name="android:textColor">@color/default_text_color</item>
        <item name="android:textColorSecondary">@color/text_color_secondary</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/navigation_bar_color</item>
        <item name="alertDialogTheme">@style/AppAlertDialogTheme</item>
        <item name="colorSurface">@color/dialog_background_color</item>
        <item name="colorOnSurface">@color/default_text_color</item>
    </style>

    <!-- Material You BottomSheet: 28dp top rounded corners, M3 standard -->
    <style name="BottomSheetM3" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetM3Style</item>
        <item name="colorSurface">@color/dialog_background_color</item>
        <item name="colorOnSurface">@color/default_text_color</item>
    </style>

    <style name="BottomSheetM3Style" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/ShapeBottomSheetM3</item>
        <item name="backgroundTint">@color/dialog_background_color</item>
    </style>

    <style name="ShapeBottomSheetM3" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ClickableBackground">
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="SeekBarTheme">
        <item name="colorAccent">@color/white</item>
    </style>

    <style name="ToolbarStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">?attr/actionBarSize</item>
        <item name="android:background">@color/toolbar_background_color</item>
        <item name="titleTextAppearance">@style/ToolbarTitle</item>
        <item name="titleTextColor">@color/toolbar_title_color</item>
    </style>

    <style name="ToolbarWithBackButtonStyle" parent="ToolbarStyle">
        <item name="navigationIcon">@drawable/ic_arrow_back</item>
        <item name="iconTint">@color/toolbar_menu_color</item>
    </style>

    <style name="ToolbarTitle" parent="@style/TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">20sp</item>
    </style>

    <style name="ToolbarMenuButtonStyle" parent="@style/Widget.AppCompat.ActionButton.Overflow">
        <item name="android:tint">@color/toolbar_menu_color</item>
    </style>

    <style name="BottomNavigationItemTextAppearance" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/bottom_navigation_item_text_size</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TabTextAppearance">
        <item name="android:textSize">@dimen/text_size_very_small</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="ButtonStyle" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/selector_color_button_text</item>
        <item name="android:background">@drawable/selector_background_button</item>
    </style>

    <style name="SmallTextViewStyle">
        <item name="android:textSize">@dimen/text_size_small</item>
        <item name="android:textColor">@color/secondary_text_color</item>
    </style>

    <style name="DefaultTextViewStyle">
        <item name="android:textSize">@dimen/text_size</item>
        <item name="android:textColor">@color/default_text_color</item>
    </style>

    <style name="LargeTextViewStyle">
        <item name="android:textSize">@dimen/text_size_large</item>
        <item name="android:textColor">@color/default_text_color</item>
    </style>

    <style name="SecondaryTextViewStyle">
        <item name="android:textColor">@color/secondary_text_color</item>
        <item name="android:textSize">@dimen/text_size_very_small</item>
    </style>

    <style name="SettingsGroupTitleTextViewStyle">
        <item name="android:textColor">@color/blue</item>
        <item name="android:textSize">@dimen/text_size_small2</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CreateBarcodeGroupTitleTextViewStyle">
        <item name="android:textColor">@color/create_barcode_group_title_text_color</item>
        <item name="android:textSize">@dimen/text_size_small2</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CreateBarcodeFragmentAlternativeTextViewStyle">
        <item name="android:textColor">@color/default_text_color</item>
        <item name="android:textSize">@dimen/text_size</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <style name="RadioButtonTheme">
        <item name="colorControlNormal">@color/gray5</item>
        <item name="colorControlActivated">@color/blue</item>
        <item name="colorControlHighlight">@android:color/transparent</item>
    </style>

    <style name="DelimiterStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/delimiter_color2</item>
    </style>

    <style name="BaseAppBarLayoutStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="liftOnScroll">true</item>
        <item name="liftOnScrollTargetViewId">@id/scrollView</item>
    </style>

    <style name="AppBarLayoutStyle" parent="BaseAppBarLayoutStyle">
        <item name="liftOnScroll">true</item>
        <item name="liftOnScrollTargetViewId">@id/scrollView</item>
    </style>

    <style name="ScrollStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="layout_behavior">@string/appbar_scrolling_view_behavior</item>
        <item name="android:scrollIndicators" tools:ignore="NewApi">none</item>
    </style>

    <style name="SwitchTheme" parent="Theme.AppCompat.Light">
        <item name="colorAccent">@color/color_accent</item>
        <item name="android:colorForeground">@color/switch_background_color</item>
    </style>

    <style name="TextInputLayoutStyle">
        <item name="android:textColorHint">@color/edit_text_hint_color</item>
    </style>

    <style name="EditTextStyle">
        <item name="android:textColor">@color/edit_text_text_color</item>
        <item name="hintTextColor">@color/edit_text_hint_color</item>
        <item name="android:textColorHint">@color/edit_text_hint_color</item>
        <item name="android:backgroundTint">@color/blue</item>
    </style>

    <!-- Material You AlertDialog: 28dp corners, M3 standard -->
    <style name="DialogTheme" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:colorBackground">@color/dialog_background_color</item>
        <item name="colorAccent">@color/color_accent</item>
        <item name="colorSurface">@color/dialog_background_color</item>
        <item name="colorOnSurface">@color/default_text_color</item>
        <item name="shapeAppearanceOverlay">@style/ShapeDialogM3</item>
        <item name="android:windowAnimationStyle">@style/DialogAnimationiOS</item>
        <item name="materialAlertDialogTitleTextStyle">@style/DialogTitleM3</item>
        <item name="materialAlertDialogBodyTextStyle">@style/DialogBodyM3</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogButtonM3</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButtonM3</item>
        <item name="buttonBarNeutralButtonStyle">@style/DialogButtonM3</item>
    </style>

    <style name="AppAlertDialogTheme" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:colorBackground">@color/dialog_background_color</item>
        <item name="colorAccent">@color/color_accent</item>
        <item name="colorSurface">@color/dialog_background_color</item>
        <item name="colorOnSurface">@color/default_text_color</item>
        <item name="android:textColor">@color/default_text_color</item>
        <item name="android:textColorSecondary">@color/secondary_text_color</item>
        <item name="shapeAppearanceOverlay">@style/ShapeDialogM3</item>
        <item name="android:windowAnimationStyle">@style/DialogAnimationiOS</item>
        <item name="materialAlertDialogTitleTextStyle">@style/DialogTitleM3</item>
        <item name="materialAlertDialogBodyTextStyle">@style/DialogBodyM3</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogButtonM3</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButtonM3</item>
        <item name="buttonBarNeutralButtonStyle">@style/DialogButtonM3</item>
    </style>

    <!-- M3 dialog corner shape: 28dp fully rounded -->
    <style name="ShapeDialogM3" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="DialogTitleM3" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/default_text_color</item>
    </style>

    <style name="DialogBodyM3" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/secondary_text_color</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <style name="DialogButtonM3" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:background">@drawable/bg_ripple_pill</item>
    </style>

    <style name="DialogAnimationiOS">
        <item name="android:windowEnterAnimation">@anim/anim_dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/anim_dialog_exit</item>
    </style>

</resources>
